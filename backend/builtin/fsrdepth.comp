#version 450
// The world's depth after the world pass (before the first-person view clears the depth buffer and draws over it): a
// copy of the scaled scene's depth into an R32F image (backend_ffx.inl, Backend::captureWorldDepth).
layout(local_size_x = 8, local_size_y = 8) in;
// Bindings as builtin/fsrinputs.comp's (one descriptor set layout): 0 the depth buffer, 3 the copy.
layout(set = 0, binding = 0) uniform sampler2D depth;
layout(set = 0, binding = 3, r32f) uniform writeonly image2D outDepth;

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(p, imageSize(outDepth)))) return;
  imageStore(outDepth, p, vec4(texelFetch(depth, p, 0).r));
}
